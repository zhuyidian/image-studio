# Fresh image site behind the existing yidian-api-caddy-1 container.
# Copy to .env.production and replace only the private credentials below.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
DATA_DIR=/app/data
APP_NAME=Yidian-Image
APP_ORIGIN=https://image.yidianhub.com
PUBLIC_ORIGIN=https://image.yidianhub.com
TRUST_PROXY_HOPS=1
PROXY_NETWORK=yidian-api_frontend

IMAGE_PROVIDER=newapi
NEW_API_BASE_URL=https://api.yidianhub.com/v1
NEW_API_KEY=REPLACE-WITH-YOUR-IMAGE-SERVICE-KEY
NEW_API_IMAGE_MODEL=gpt-image-2
NEW_API_TIMEOUT_MS=180000
STANDARD_IMAGE_CREDITS=12
HIGH_IMAGE_CREDITS=24
MAX_ACTIVE_TASKS_PER_USER=2
WORKER_CONCURRENCY=1

ALLOW_REGISTRATION=false
SIGNUP_CREDITS=0
EMAIL_VERIFICATION_REQUIRED=true
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE-WITH-YOUR-SENDER@qq.com
SMTP_PASS="REPLACE-WITH-YOUR-QQ-SMTP-AUTHORIZATION-CODE"
SMTP_FROM=REPLACE-WITH-YOUR-SENDER@qq.com

PAYMENT_PROVIDER=disabled
