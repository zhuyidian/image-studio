NODE_ENV=production
HOST=0.0.0.0
PORT=8787
APP_NAME=Yidian-Image
APP_ORIGIN=https://image.yidianhub.com
PUBLIC_ORIGIN=https://image.yidianhub.com
DATA_DIR=/app/data
TRUST_PROXY_HOPS=1
IMAGE_PROVIDER=newapi
NEW_API_BASE_URL=https://YOUR-NEW-API-HOST/v1
NEW_API_KEY=REPLACE-WITH-A-RESTRICTED-SERVICE-KEY
NEW_API_IMAGE_MODEL=gpt-image-2
NEW_API_TIMEOUT_MS=180000
ALLOW_REGISTRATION=false
SIGNUP_CREDITS=0
EMAIL_VERIFICATION_REQUIRED=true
MAIL_TRANSPORT=disabled
# Configure real SMTP before opening verified registration/password recovery.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@your-domain.com
# SMTP_PASS=replace-on-server-only
# SMTP_FROM=no-reply@your-domain.com
STANDARD_IMAGE_CREDITS=12
HIGH_IMAGE_CREDITS=24
MAX_ACTIVE_TASKS_PER_USER=2
WORKER_CONCURRENCY=2
PAYMENT_PROVIDER=disabled
