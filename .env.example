# Copy to .env. Never put real keys in browser variables or Git.
# NODE_ENV defaults to development in the API; do not force it in Vite's .env.
PORT=8787
HOST=127.0.0.1
# Use 1 only when the application is reachable exclusively through one trusted reverse proxy.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://127.0.0.1:5173
APP_NAME=Yidian-Image
DATA_DIR=./data
# mock does not call an upstream or spend money. newapi makes real paid calls.
IMAGE_PROVIDER=mock
NEW_API_BASE_URL=https://your-new-api.example.com/v1
NEW_API_KEY=
NEW_API_IMAGE_MODEL=gpt-image-2
# Only seeds the model directory on first startup. Edit existing models in the admin page.
NEW_API_TIMEOUT_MS=180000
# Initial directory prices per successful image; subsequent changes belong in model management.
STANDARD_IMAGE_CREDITS=12
HIGH_IMAGE_CREDITS=24
# Enable only after pricing, upload and abuse controls have been reviewed.
ALLOW_REGISTRATION=true
SIGNUP_CREDITS=36
# These seed the admin "注册与邮箱" settings once; later edits belong in the admin page.
EMAIL_VERIFICATION_REQUIRED=true
# file is for local testing only. Production must use smtp or disabled.
MAIL_TRANSPORT=file
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-private-smtp-authorization-code
# SMTP_FROM=no-reply@example.com
MAX_ACTIVE_TASKS_PER_USER=2
WORKER_CONCURRENCY=2
# disabled by default; epay means an EPay-compatible merchant, not native WeChat/Alipay.
PAYMENT_PROVIDER=disabled
EPAY_BASE_URL=
EPAY_MERCHANT_ID=
EPAY_MERCHANT_KEY=
# Public URL of this site's API, used for payment notification and return URLs.
PUBLIC_ORIGIN=http://127.0.0.1:5173
